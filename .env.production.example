# Variables de producción (docker-compose.prod.yml). Copia este archivo a .env.production, complétalo y
# NO lo versiones (.gitignore ya lo cubre). Guía completa: docs/deploy.md.

# --- Supabase (proyecto en la nube: Settings → API y Settings → Database) ---
# Cadena de conexión de Postgres. Usa el "connection pooler" (modo transaction o session) y
# sslmode=require. La API conecta como postgres: protege esta cadena como protegerías una llave maestra.
DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Claves públicas con las que se verifican los JWT de Supabase Auth (ES256).
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# Secreto JWT del proyecto (Settings → API → JWT Secret), para tokens HS256.
SUPABASE_JWT_SECRET=
# Emisor exigido en el JWT (recomendado en producción): https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
# URL del proyecto y clave pública (anon): se incrustan al compilar la web. NUNCA la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API ---
# Proxies de confianza delante de la API (1 si hay un balanceador o nginx). Vacío = ninguno.
TRUST_PROXY=1
# false para no publicar /docs y /openapi.json.
DOCS_ENABLED=false
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT=120
# RATE_LIMIT_SYNC=60
# RATE_LIMIT_STRICT=20
# Aviso por webhook cuando un agente deja de dar señales (ver docs/agent-alerts.md). Vacío = apagado.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=

# --- Web ---
# NUNCA true en producción real.
DEMO_MODE=false

# --- Opcionales ---
# IMAGE_TAG=1.0.0
# API_HOST_PORT=3001
# WEB_HOST_PORT=3100
