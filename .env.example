# Copia este archivo a .env y ajusta los valores. .env está en .gitignore.
# Contraseña del usuario sa del SQL Server del sandbox de Saint.
# Debe cumplir la política de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Saint_Demo_2026!
# Puerto del host hacia el 1433 del contenedor (14330 evita chocar con un SQL Server local).
MSSQL_HOST_PORT=14330

# --- API (apps/api) ---
# Base de datos de la API. Por defecto, la de `pnpm db:start` (Supabase local).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Secreto HS256 con el que Supabase firma los JWT de usuario (`pnpm db:status`, campo JWT_SECRET).
# El valor de abajo es el de la pila local; en producción usa el real y cámbialo por JWKS.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
