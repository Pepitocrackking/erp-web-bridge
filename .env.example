# Copia este archivo a .env y ajusta los valores. .env está en .gitignore.
# Contraseña del usuario sa del SQL Server del sandbox de Saint.
# Debe cumplir la política de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Saint_Demo_2026!
# Puerto del host hacia el 1433 del contenedor (14330 evita chocar con un SQL Server local).
MSSQL_HOST_PORT=14330

# --- API (apps/api) ---
# Base de datos de la API. Por defecto, la de `pnpm db:start` (Supabase local).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Secreto HS256 con el que Supabase firma los JWT de usuario (`pnpm db:status`, campo JWT_SECRET).
# El valor de abajo es el de la pila local; en producción usa el real y cámbialo por JWKS.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Rate limiting por IP y por ruta, en peticiones por ventana (valores por defecto entre paréntesis).
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT=120   (resto de endpoints)
# RATE_LIMIT_SYNC=60       (ingesta del agente: /v1/sync/*)
# RATE_LIMIT_STRICT=20     (crear pedidos y fijar la tasa)
# Proxies de confianza delante de la API (0 o vacío = ninguno). Solo así se usa X-Forwarded-For para
# identificar al cliente; con un valor equivocado se podría esquivar el rate limit. Ej.: 1 tras un nginx.
# TRUST_PROXY=
# Publica /docs (Swagger UI) y /openapi.json. false para apagarlos.
# DOCS_ENABLED=true
# Aviso por webhook cuando el agente local de una organización deja de dar señales (y cuando vuelve):
# un POST JSON, una vez por caída y otra por recuperación. Vacío = apagado (el panel avisa igual).
# https obligatorio (http solo hacia localhost). Una URL inválida detiene el arranque.
# NOTIFY_WEBHOOK_URL=
# Si se define, el cuerpo se firma: cabecera x-erp-bridge-signature = sha256=<HMAC-SHA256 hex del cuerpo>.
# NOTIFY_WEBHOOK_SECRET=
# Sin latido durante estos segundos = sin conexión (igual que la ventana del panel) y cada cuánto se revisa.
# NOTIFY_OFFLINE_AFTER_SECONDS=180
# NOTIFY_CHECK_INTERVAL_SECONDS=60
# Tasa de cambio automática (BCV). Cada organización la activa en su panel; la API consulta las
# fuentes una vez por vuelta para todas. Si BCV_FALLBACK_URL queda vacía, no hay respaldo.
# BCV_URL=https://www.bcv.org.ve/
# BCV_FALLBACK_URL=https://ve.dolarapi.com/v1/dolares/oficial
# BCV_TIMEOUT_MS=10000
# Una lectura que varíe más que esto (%) frente a la tasa vigente se descarta y se avisa en el panel.
# BCV_MAX_JUMP_PERCENT=25
# Cada cuántos segundos la API busca organizaciones a las que les toca actualizar; BCV_SCHEDULER=false lo apaga.
# BCV_CHECK_INTERVAL_SECONDS=60
# BCV_SCHEDULER=true

# --- Web (apps/web) ---
# URL y clave pública (anon) de Supabase. La clave anon es pública por diseño: RLS protege los datos.
# Los valores de abajo son los de la pila local (`pnpm db:start`); `pnpm db:status` los muestra.
# Cópialos a apps/web/.env.local. NUNCA pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# URL de la API NestJS (escrituras de negocio: pedidos, tasa).
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL de la API que usa el servidor de Next para crear pedidos (no llega al navegador).
# Si no se define, se usa NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:3001
# JWKS de Supabase Auth: claves públicas para verificar los JWT ES256 de los usuarios (el CLI
# reciente y los proyectos nuevos firman así). Por defecto, el de la pila local.
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Emisor exigido en el claim `iss` de los JWT (opcional; recomendado en producción).
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Modo demo (SOLO local o la demo pública): muestra "Entrar como Administrador Demo", que inicia
# sesión sin registro con el administrador de la organización de ejemplo. En producción real debe
# estar apagado o ausente; es una variable de servidor y nunca llega al navegador.
# DEMO_MODE=true
# DEMO_ADMIN_EMAIL=admin@demo-saint.test
# DEMO_ADMIN_PASSWORD=demo1234

# Simulador de ERP del panel (tarea 6.6): clave de AGENTE de la organización de demostración, solo
# servidor. Sin ella, el simulador solo existe en modo demo (usa la clave de desarrollo del seed).
# SIMULATOR_API_KEY=erp_dev_demo_saint_key
# SIMULATOR_ORG_SLUG=demo-saint
